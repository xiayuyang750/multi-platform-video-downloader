# Python 虚拟环境与缓存（可由 requirements 重建，不纳入版本控制）
.venv/
__pycache__/
*.py[cod]

# 安卓构建产物
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/.idea/
android/local.properties
android/*.keystore
# 签名口令，绝不能进版本控制
android/keystore.properties
android/release.keystore

# 安卓端中间产物：交叉编译 QuickJS 等原生依赖时的构建树
android/.build-tmp/
android/.kotlin/

# 安卓端原生依赖：体积大，由脚本交叉编译/下载生成
android/app/src/main/jniLibs/**/libqjs.so
android/app/src/main/jniLibs/**/libffmpeg.so
android/app/src/main/jniLibs/**/libffprobe.so

# 本机运行数据与临时文件
*.db
*.log
.browser-profile/
Thumbs.db
desktop.ini

# 授权联调服务器的本地数据（里面是测试密钥，不进仓库）
server/.dev-data.json

# Office 打开文档时产生的锁文件
~$*

# 授权配置备忘：含 LICENSE_SECRET 与 ADMIN_TOKEN，绝不能进版本控制
docs/授权服务-配置备忘.docx

# 本机测试用的链接清单与登录凭据（test-cookie.md 里是 Netscape 格式的会话 Cookie）。
# 这两个文件都躺在仓库目录里，本地方便，但绝不能进公开仓库 —— 漏一条就是凭据泄漏。
test-cookie.md
测试链接.txt
