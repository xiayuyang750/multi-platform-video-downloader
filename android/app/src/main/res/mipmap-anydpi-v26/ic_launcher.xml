<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标（自适应图标，Android 8.0+）。

  这里只描述「分层」这件事，具体图形在 drawable 里：
  - background：薄荷→天蓝的渐变
  - foreground：白色圆角方块 + 镂空播放三角
  - monochrome：给 Android 13+ 主题图标用，系统会把它的不透明区域重新上色，
    所以直接复用前景层即可（它本来就是单色轮廓）

  另外 mipmap-<density>/ic_launcher.png 是同一套图案的位图版，两处都要留：
  自适应图标只有系统认识，而文件管理器、应用商店这类第三方工具解析 APK 时
  只会去找传统位图 —— 缺了它，安装前的安装包就是没有图标的。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
