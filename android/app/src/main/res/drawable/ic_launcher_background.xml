<?xml version="1.0" encoding="utf-8"?>
<!--
  图标背景层：薄荷绿 → 天蓝的对角渐变。

  为什么用 drawable 而不是颜色资源：自适应图标的 background 层是可以放矢量的，
  渐变放在这一层，系统在裁切/缩放图标时会连渐变一起处理，不会出现描边错位。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#34D399"
                android:endColor="#0EA5E9" />
        </aapt:attr>
    </path>
</vector>
