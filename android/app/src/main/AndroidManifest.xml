<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      「所有文件访问权限」：yt-dlp 走普通文件 API 写文件，而 Android 11+
      的分区存储不让应用直接用路径写公共目录。没有它就只能落到应用私有目录
      （文件管理器看不到，用户找不到下载的文件）。
      这是敏感权限，所以应用里做了首启引导，且未授权时会自动回退到私有目录 ——
      不授权也能用，只是文件位置没那么好找。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ytdlp"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 接收其他应用分享过来的链接：在 B站/YouTube 客户端里点
                 「分享」就能直接选本应用，省掉「复制 → 切过来 → 粘贴」三步。
                 分享的文本常常不只一个 URL（比如「【标题】 https://…」），
                 所以拿到后要自己从文本里挑出链接。
                 singleTop 是为了避免每次分享都新开一个 Activity 实例。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 引擎自检页：不是给用户用的，而是排查引擎问题时的诊断入口。
             v1.0.3 把设置页里那个入口删掉了 —— 它一进去就自动跑三条网络解析，
             用户看到一屏原始 JSON 只会以为应用卡死或偷跑流量。

             这里刻意设为 exported="true"：不导出的话 adb 根本起不来。
             原先这段注释写着「只能用 adb 启动」，但 exported="false" 且没有
             intent-filter，实际两条路都走不通 —— 实测 adb 会被
             SecurityException（Permission Denial: not exported）拒掉，
             那句注释一直没人验证过。
             没有 intent-filter，桌面不会出现图标；被别的应用按组件名拉起也只能
             看到日志，按钮还得用户自己点，不构成实际风险。 -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:label="引擎自检" />

        <!-- 抖音的浏览器模式解析页：单独开一个 Activity 是因为 WebView 需要
             一个宿主窗口，解析完把结果 setResult 回传并关闭。 -->
        <activity
            android:name=".DouyinActivity"
            android:exported="false"
            android:label="浏览器模式解析"
            android:theme="@style/Theme.Ytdlp" />

        <!-- 意见反馈页：从设置页进入，填完直接发到开发者的企业微信群。
             windowSoftInputMode 用 adjustResize，否则展开键盘会盖住输入框。 -->
        <activity
            android:name=".FeedbackActivity"
            android:exported="false"
            android:label="意见反馈"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Ytdlp" />
    </application>

</manifest>
