<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ytdlp"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 接收其他应用分享过来的链接：在 B站/YouTube 客户端里点
                 「分享」就能直接选本应用，省掉「复制 → 切过来 → 粘贴」三步。
                 分享的文本常常不只一个 URL（比如「【标题】 https://…」），
                 所以拿到后要自己从文本里挑出链接。
                 singleTop 是为了避免每次分享都新开一个 Activity 实例。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 引擎自检页：不是给用户用的，而是排查引擎问题时的诊断入口。
             不设 intent-filter，所以桌面看不到图标，只能用
             adb shell am start -n com.ytdlp.android/.ProbeActivity 启动。 -->
        <activity
            android:name=".ProbeActivity"
            android:exported="false"
            android:label="引擎自检" />

        <!-- 抖音的浏览器模式解析页：单独开一个 Activity 是因为 WebView 需要
             一个宿主窗口，解析完把结果 setResult 回传并关闭。 -->
        <activity
            android:name=".DouyinActivity"
            android:exported="false"
            android:label="浏览器模式解析"
            android:theme="@style/Theme.Ytdlp" />
    </application>

</manifest>
